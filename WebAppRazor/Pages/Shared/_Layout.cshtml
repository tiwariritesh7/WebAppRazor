<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebAppRazor</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebAppRazor.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentPath = Context.Request.Path.Value ?? "/";
        Func<string, string> navClass = (page) =>
            string.Equals(currentPath, page, StringComparison.OrdinalIgnoreCase) ? "nav-link active" : "nav-link text-light";
    }

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary sticky-top">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-page="/Index">
                    <img src="~/images/logo.png" alt="" width="28" height="28" class="d-inline-block align-text-top me-2" />
                    <span>WebAppRazor</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="@navClass("/Index")" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="@navClass("/Privacy")" asp-area="" asp-page="/Privacy">Privacy</a>
                        </li>
                        <li class="nav-item">
                            <a class="@navClass("/RegisterCustomer")" asp-area="" asp-page="/RegisterCustomer">Register Customer</a>
                        </li>
                        <li class="nav-item">
                            <a class="@navClass("/AddNewProduct")" asp-area="" asp-page="/AddNewProduct">Create Product</a>
                        </li>
                        <li class="nav-item">
                            <a class="@navClass("/SaleProductToCustomer")" asp-area="" asp-page="/SaleProductToCustomer">Assign Product</a>
                        </li>
                    </ul>
                    <form class="d-flex" role="search" method="get" asp-page="/Index">
                        <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search" name="q">
                        <button class="btn btn-outline-light" type="submit">Search</button>
                    </form>
                </div>
            </div>
        </nav>
    </header>
    <main role="main" class="container my-4">
        @RenderBody()
    </main>

    <footer class="border-top bg-light text-muted py-3 mt-4">
        <div class="container d-flex justify-content-between align-items-center">
            <small>&copy; 2026 WebAppRazor</small>
            <div>
                <a class="text-muted me-3" asp-area="" asp-page="/Privacy">Privacy</a>
                <a class="text-muted" href="https://github.com/tiwariritesh7/WebAppRazor" target="_blank" rel="noopener">GitHub</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js" defer></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
