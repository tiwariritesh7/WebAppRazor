@page
@model WebAppRazor.Pages.AddNewProductModel

<h2>Add New Product</h2>

<form method="post" class="row gx-3 gy-2 align-items-center">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="col-12 mb-3">
        <label asp-for="Product.Name" class="form-label">Name</label>
        <input asp-for="Product.Name" class="form-control" required />
        <span asp-validation-for="Product.Name" class="text-danger"></span>
    </div>

    <div class="col-md-4 mb-3">
        <label asp-for="Product.Price" class="form-label">Price</label>
        <input asp-for="Product.Price" type="number" step="0.01" class="form-control" required />
        <span asp-validation-for="Product.Price" class="text-danger"></span>
    </div>

    <div class="col-12 mb-3">
        <label asp-for="Product.Description" class="form-label">Description</label>
        <textarea asp-for="Product.Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Product.Description" class="text-danger"></span>
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-primary">Add Product</button>
    </div>
</form>

@if (Model.Message != null)
{
    <div class="alert alert-success mt-3">@Model.Message</div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
