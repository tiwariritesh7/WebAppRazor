@page
@model WebAppRazor.Pages.AddNewProductModel

<h2>Add New Product</h2>

<form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div>
        <label asp-for="Product.Name">Name</label>
        <input asp-for="Product.Name" required />
        <span asp-validation-for="Product.Name" class="text-danger"></span>
    </div>
    <div>
        <label asp-for="Product.Price">Price</label>
        <input asp-for="Product.Price" type="number" step="0.01" required />
        <span asp-validation-for="Product.Price" class="text-danger"></span>
    </div>
    <div>
        <label asp-for="Product.Description">Description</label>
        <textarea asp-for="Product.Description"></textarea>
        <span asp-validation-for="Product.Description" class="text-danger"></span>
    </div>
    <div>
        <button type="submit">Add Product</button>
    </div>
</form>

@if (Model.Message != null)
{
    <p>@Model.Message</p>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
