@page
@model WebAppRazor.Pages.IndexModel
@{
    ViewData["Title"] = "Customer Projects";
}

<h2>Customer Project List</h2>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>#</th>
            <th>Image</th>
            <th>Customer</th>
            <th>Product</th>
            <th>Price</th>
            <th>Created</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.customerProducts)
    {
        <tr>
            <td>@item.Id</td>
            @{ var img = Model.ProductImages.ContainsKey(item.ProductId) ? Model.ProductImages[item.ProductId] : "placeholder.png"; }
            <td>
                <img src="~/images/products/@img" alt="Product image" class="img-thumbnail" style="max-width:80px;" />
            </td>
            <td>@item.Name</td>
            <td>@item.ProductName</td>
            <td>@item.Price</td>
            <td>@item.CreatedDate.ToString("g")</td>
        </tr>
    }
    </tbody>
    </table>
</div>
